{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nakfreeajer/artifact-relay-manager/schemas/relay-event.schema.json",
  "title": "Normalized Relay Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eventId", "projectId", "eventType", "artifact", "provider", "observedAt"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "eventType": {
      "enum": [
        "PROMPT_READY",
        "RESULT_READY",
        "HANDOVER_READY",
        "SYSTEM_SNAPSHOT_READY",
        "ARTIFACT_CHANGED",
        "PROJECT_IDENTITY_CHANGED"
      ]
    },
    "taskId": {
      "type": ["string", "null"]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "sha256", "byteLength"],
      "properties": {
        "artifactId": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version"],
      "properties": {
        "kind": {
          "const": "google-drive"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
